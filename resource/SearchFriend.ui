  <property name="styleSheet">
   <string notr="true">/* ======================
   SearchFriend 整体
   ====================== */
QWidget#SearchFriendClass {
    background: #F5F6F7;
    color: #222222;
    font-family: &quot;Microsoft YaHei&quot;;
}

/* ======================
   顶部栏
   ====================== */
QWidget#titleBar {
    background: transparent;
}

QLabel#titleLabel {
    background: transparent;
    color: #222222;
}

QToolButton#closeButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #333333;
}

QToolButton#closeButton:hover {
    background: rgba(0,0,0,0.06);
}

QToolButton#closeButton:pressed {
    background: rgba(0,0,0,0.10);
}

/* ======================
   搜索区
   ====================== */
QWidget#searchCard {
    border: 1px solid #E6E8EB;
    border-radius: 12px;
}

QLineEdit#searchEdit {
    background: #EBECF0;
    border: 1px solid #D9DEE5;
    border-radius: 10px;
    padding: 0 12px;
    color: #222222;
    min-height: 40px;
}

QLineEdit#searchEdit:focus {
    background: #FFFFFF;
    border: 1px solid rgba(42,130,255,0.55);
}

QPushButton#searchButton {
    background: #2A82FF;
    color: white;
    border: none;
    border-radius: 10px;
    min-width: 92px;
    max-width: 92px;
    min-height: 40px;
    max-height: 40px;
    font-weight: 600;
}

QPushButton#searchButton:hover {
    background: #2275E6;
}

QPushButton#searchButton:pressed {
    background: #1B62C7;
}

/* ======================
   结果列表：自己承担容器效果
   ====================== */
QListWidget#friendList {
    background: #F7F8FA;
    border: 1px solid #E6E8EB;
    border-radius: 12px;
    outline: none;
    padding: 8px;
}

QListWidget#friendList::item {
    border: none;
    background: transparent;
    padding: 4px 0px;
    margin: 2px 0px;
}

QListWidget#friendList::item:hover {
    background: transparent;
}

QListWidget#friendList::item:selected {
    background: transparent;
}

/* viewport */
QListWidget#friendList QAbstractScrollArea::viewport {
    background: transparent;
    border-radius: 12px;
}
</string>
