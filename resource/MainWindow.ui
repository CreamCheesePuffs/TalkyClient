  <property name="styleSheet">
   <string notr="true">/* ======================
   全局 / 主窗口背景
   ====================== */
QMainWindow {
    background: #F5F6F7;
}

QWidget#centralWidget {
    background: #F5F6F7;
    color: #222;
    font-family: &quot;Microsoft YaHei&quot;;
}

QWidget {
    color: #222;
}

/* 容器默认透明，避免全局背景污染 */
QFrame, QGroupBox {
    background: transparent;
}

/* ======================
   左侧 navPanel
   ====================== */
QWidget#navPanel {
    background: #F7F8FA;
    border-right: 1px solid #E6E8EB;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px;
}

QToolButton:hover {
    background: rgba(0,0,0,0.06);
}

QToolButton:pressed {
    background: rgba(0,0,0,0.10);
}

/* ======================
   中间 listPanel
   ====================== */
QWidget#listPanel {
    background: #F7F8FA;
    border-right: 1px solid #E6E8EB;
}

/* 搜索框 */
QLineEdit{
	background: #F5F6F7;
    border: 1px solid #E3E5E8;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #2A82FF;
}

QLineEdit#searchFriend_lineEdit{
    background: #EBECF0;
}

QLineEdit:focus {
    background: #FFFFFF;
    border: 1px solid rgba(42,130,255,0.55);
}

/* 会话列表 */
QListWidget#chatList {
    background: transparent;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#chatList::item {
    padding: 0px;
    margin: 2px 0px;
    border: none;
}

QListWidget#chatList::item:hover,
QListWidget#chatList::item:selected {
    background: transparent;
}

/* 会话项 */
QWidget#ChatItemClass {
    background: transparent;
    border-radius: 10px;
}

QWidget#ChatItemClass[hover=&quot;true&quot;] {
    background: rgba(34,117,230,0.10);
}

QWidget#ChatItemClass[selected=&quot;true&quot;] {
    background: rgba(34,117,230,0.16);
}

/* ======================
   右侧 chatPanel
   ====================== */
QWidget#chatPanel {
    background: #F5F6F7;
}

QWidget#headerBar {
    background: #F5F6F7;
    border: none;
}

/* 如果你顶部有名字标签，建议给 objectName */
QLabel#titleLabel {
    background: transparent;
    color: #111111;
    font-size: 16px;
    font-weight: 600;
}

QLabel#subTitleLabel {
    background: transparent;
    color: #8A8F98;
    font-size: 12px;
}

/* 消息区 */
QListWidget#messageList {
    background: #F5F6F7;
    border: none;
    outline: none;
    padding: 12px 14px 12px 14px;
}

QListWidget#messageList::item {
    background: transparent;
    border: none;
}

QListWidget#messageList:focus {
    outline: none;
}

QListWidget#messageList QAbstractScrollArea::viewport {
    background: #F5F6F7;
}

/* 底部输入区：改成白底独立区 */
QWidget#composerBar {
    background: #FFFFFF;
    border-top: 1px solid #E6E8EB;
}

QTextEdit#messageEdit {
    border: 1px solid #D9DEE5;
    border-radius: 12px;
    padding: 10px 12px;
    color: #222222;
    selection-background-color: #2A82FF;
}

QTextEdit#messageEdit:focus {
    background: #FFFFFF;
    border: 1px solid rgba(42,130,255,0.55);
}

QPlainTextEdit#messageEdit {
    background: #F7F8FA;
    border: 1px solid #D9DEE5;
    border-radius: 12px;
    padding: 10px 12px;
    color: #222222;
    selection-background-color: #2A82FF;
}

QPlainTextEdit#messageEdit:focus {
    background: #FFFFFF;
    border: 1px solid rgba(42,130,255,0.55);
}

/* 发送按钮 */
QPushButton#sendButton {
    background: #2A82FF;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    min-width: 72px;
    min-height: 36px;
}

QPushButton#sendButton:hover {
    background: #2275E6;
}

QPushButton#sendButton:pressed {
    background: #1B62C7;
}

/* ======================
   滚动条
   ====================== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(0,0,0,0.15);
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(0,0,0,0.25);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}</string>
